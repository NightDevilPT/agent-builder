# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/agent_builder?schema=public"

# API Configurations
NEXT_PUBLIC_API_URL=http://localhost:3000

# Security (JWT)
JWT_SECRET=default_jwt_secret_change_me_in_production
JWT_ACCESS_EXPIRY=15m

# Rate Limiting Configurations (Optional custom overrides)
# RATE_LIMIT_DEFAULT_LIMIT=60
# RATE_LIMIT_DEFAULT_WINDOW=60000
# RATE_LIMIT_AUTH_LIMIT=10
# RATE_LIMIT_AUTH_WINDOW=60000
# RATE_LIMIT_WORKFLOWS_LIMIT=30
# RATE_LIMIT_WORKFLOWS_WINDOW=60000
# RATE_LIMIT_EXECUTION_LIMIT=5
# RATE_LIMIT_EXECUTION_WINDOW=60000
